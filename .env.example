# Ironwise configuration
# Copy to .env and adjust. All settings are IRONWISE_* environment variables.

IRONWISE_API_KEY=change-me
IRONWISE_DB_PATH=./data/ironwise.db
IRONWISE_AUDIT_PATH=./data/audit.log
IRONWISE_LLM_BASE_URL=http://127.0.0.1:8080/v1
IRONWISE_LLM_MODEL=ironwise
IRONWISE_HOST=127.0.0.1
IRONWISE_PORT=8000
